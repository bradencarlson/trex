digraph {
        s [label="start"]
        c [label="compile",shape="box"]
        e [label="*.aux exists"]
        h1 [label="hash *.aux"]
        h2 [label="hash *.aux"]
        two_hash_aux [label="two *.aux hashes?"]
        diff1 [label="they differ"]
        diff2 [label="they differ"]
        end [label="end"]
        search [label="search *.aux"]
        search_bib [label="search *.aux for bib"]
        bib [label="run bibtex",shape="box"]
        e_bbl [label="*.bbl exists"]
        hash_b1 [label="hash *.bbl"]
        hash_b2 [label="hash *.bbl"]
        two_hash_bib [label="two *.bib hashes?"]

        s -> e

        e -> h1 [label="1"]
        e -> e_bbl [label="0"]
        h1 -> e_bbl [label="0,1"]
        e_bbl -> hash_b1 [label="1"]
        e_bbl -> c [label="0"]
        hash_b1 -> c [label="0,1"]


        c -> h2 [label="0,1"]
        h2 -> search_bib [label="0,1"]
        search_bib -> bib [label="1"]
        bib -> hash_b2 [label="0,1"]
        hash_b2 -> two_hash_bib [label="0,1"]
        two_hash_bib -> diff2 [label="1"]
        two_hash_bib -> c [label="0"]
        diff2 -> c [label="1"]
        diff2 -> two_hash_aux [label="0"]

        search_bib -> two_hash_aux [label="0"]
        
        two_hash_aux -> diff1 [label="1"]
        diff1 -> c [label="1"]
        diff1 -> end [label="0"]

        two_hash_aux -> search [label="0"]
        search -> c [label="1"]
        search -> end [label="0"]



}
